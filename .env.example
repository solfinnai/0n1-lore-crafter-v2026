# Example environment file
# Copy this to .env.local and fill in your actual API keys

# Anthropic API Key (required) - powers character/lore CREATION (wizard
# suggestions, summaries) via Claude. Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Llama key (required for chat) - powers all character CHAT via an uncensored
# Llama model on any OpenAI-compatible host (OpenRouter by default).
# OPENROUTER_API_KEY works as an alias. Chat falls back to Claude if unset.
LLAMA_API_KEY=your_openrouter_api_key_here
# LLAMA_BASE_URL=https://openrouter.ai/api/v1
# LLAMA_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenSea API Key - Get from https://opensea.io/account#api
OPENSEA_API_KEY=your_opensea_api_key_here
